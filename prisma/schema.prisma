generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Source {
  id            String    @id @default(cuid())
  name          String
  url           String
  type          String    // "officiel" | "cabinet"
  scraper       String    // identifiant du scraper
  active        Boolean   @default(true)
  lastScrapedAt DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())
  articles      Article[]
}

model Article {
  id          String   @id @default(cuid())
  title       String
  summary     String?
  url         String   @unique
  publishedAt DateTime
  categories  String   @default("[]") // JSON array stringifié
  sourceId    String
  source      Source   @relation(fields: [sourceId], references: [id])
  createdAt   DateTime @default(now())
}

model Exercise {
  id          String       @id @default(cuid())
  name        String       @unique
  muscleGroup String       // "jambes" | "poitrine" | "dos" | "epaules" | "bras" | "mollets" | "cou" | "abdos"
  isDefault   Boolean      @default(false)
  createdAt   DateTime     @default(now())
  sets        WorkoutSet[]
}

model Workout {
  id           String       @id @default(cuid())
  date         DateTime     @default(now())
  dayType      String       // "jambes" | "torse" | "bras" | "endurance" | "cardio" | "hiit" | "recuperation"
  phase        String?      // "force" | "hypertrophie" (musculation uniquement)
  durationMin  Int?
  distanceKm   Float? // cardio
  avgHeartRate Int? // cardio — FC moyenne
  rpe          Int? // effort perçu 1–10
  notes        String?
  createdAt    DateTime     @default(now())
  sets         WorkoutSet[]
}

model WorkoutSet {
  id         String   @id @default(cuid())
  workoutId  String
  workout    Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id])
  setNumber  Int
  reps       Int
  weightKg   Float    @default(0)
  isWarmup   Boolean  @default(false) // exclu du volume, des records et des courbes
  createdAt  DateTime @default(now())
}

model BodyWeightEntry {
  id        String   @id @default(cuid())
  date      DateTime @unique // jour (minuit) — une pesée par jour
  weightKg  Float
  createdAt DateTime @default(now())
}

model WaterEntry {
  id        String   @id @default(cuid())
  date      DateTime // jour (minuit)
  amountMl  Int
  createdAt DateTime @default(now())
}

model FitnessSetting {
  id            String   @id @default("default")
  phaseOverride String? // "force" | "hypertrophie" | null = auto (parité du mois)
  waterGoalMl   Int      @default(2500)
  updatedAt     DateTime @updatedAt
}

model FoodEntry {
  id        String   @id @default(cuid())
  date      DateTime // jour de consommation (minuit)
  meal      String   // "petit-dejeuner" | "dejeuner" | "diner" | "collation"
  name      String
  quantityG Float    // quantité en grammes
  calories  Float    // kcal pour la quantité
  proteinG  Float    @default(0)
  carbsG    Float    @default(0)
  fatG      Float    @default(0)
  source    String   @default("manuel") // "openfoodfacts" | "manuel"
  createdAt DateTime @default(now())
}

model NutritionGoal {
  id        String   @id @default("default")
  calories  Int      @default(2500)
  proteinG  Int      @default(140)
  updatedAt DateTime @updatedAt
}

model SleepEntry {
  id          String    @id @default(cuid())
  date        DateTime  @unique // jour du réveil (minuit) — une entrée par nuit
  bedTime     DateTime?
  wakeTime    DateTime?
  durationMin Int
  quality     Int? // 1–5
  source      String    @default("manuel") // "manuel" | "apple-sante"
  notes       String?
  createdAt   DateTime  @default(now())
}

model AlertSubscription {
  id        String   @id @default(cuid())
  email     String   @unique
  keywords  String   @default("[]") // JSON array stringifié
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}
